      },
      {
        "columnName": "dateAdded",
        "columnType": "timestamp_ntz",
        "columnDescription": "Date this note was created"
      },
      {
        "columnName": "dateUpdated",
        "columnType": "timestamp_ntz",
        "columnDescription": "Date the note was last updated"
      },
      {
