        "columnDescription": "date of this route"
      },
      {
        "columnName": "dayNotes",
        "columnType": "string",
        "columnDescription": "Notes about this route viewable from the day schedule page"
      },
      {
        "columnName": "dayAlert",
        "columnType": "string",
        "columnDescription": "Alert notes for day schedule page"
      },
      {
        "columnName": "dayID",
