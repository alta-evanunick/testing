      },
      {
        "columnName": "estimatedDrivingDurationSeconds",
        "columnType": "integer",
        "columnDescription": "Estimated driving duration in seconds"
      },
      {
        "columnName": "dateUpdated",
        "columnType": "timestamp_ntz",
        "columnDescription": "date this route was last updated"
      }
